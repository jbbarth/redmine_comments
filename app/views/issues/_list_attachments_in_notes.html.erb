<% if journal.journal_attachments.any? %>

    <div class="attachments">
      <table>
        <% for attachment in journal.journal_attachments %>
            <tr>
              <td>
                <%= link_to_attachment attachment, icon: 'attachment' -%>
                <span class="size">(<%= number_to_human_size attachment.filesize %>)</span>
                <%= link_to_attachment attachment, icon: 'download', class: 'icon-only', title: l(:button_download), download: true -%>
              </td>
              <td><%= attachment.description unless attachment.description.blank? %></td>
              <td>
                  <span class="author"><%= attachment.author %>, <%= format_time(attachment.created_on) %></span>
              </td>
              <td>
                <%= link_to sprite_icon('del', l(:button_delete), icon_only: true), "/issue_comments/destroy_attachment/#{attachment.id}",
                            :data => {:confirm => l(:text_are_you_sure)},
                            :method => :delete,
                            :class => 'delete icon-only',
                            :title => l(:button_delete) %>
              </td>
            </tr>
        <% end %>
      </table>
      <% if defined?(thumbnails) && thumbnails %>
          <% images = journal.journal_attachments.select(&:thumbnailable?) %>
          <% if images.any? %>
              <div class="thumbnails">
                <% images.each do |attachment| %>
                    <div><%= thumbnail_tag(attachment) %></div>
                <% end %>
              </div>
          <% end %>
      <% end %>
    </div>

<% end %>
